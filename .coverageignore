# Files that carry no diff-coverage obligation (scripts/diff-coverage.mjs).
# Every entry must name the file and the reason; they mirror the `coverage.exclude` lists in the
# package vitest configs, which vitest applies but the diff gate cannot read.
# Syntax: one repo-relative path per line, `#` starts a comment.

# Process bootstrap: binds a port and opens DB/Redis connections, so it can only be exercised by
# the e2e job (apps/api/vitest.config.ts excludes it from coverage for the same reason).
apps/api/src/server.ts

# Better-Auth wiring: constructs the auth instance against a live Prisma client, so unit tests
# cannot import it without a database. Exercised end to end by the e2e job (J01 signup).
apps/api/src/auth/index.ts

# Pure re-export barrels (no executable statements, so v8 reports no coverage entry at all).
packages/config/src/index.ts
packages/db/src/index.ts
packages/domain/src/index.ts
packages/domain/src/nodes/index.ts
packages/domain/src/edges/index.ts
packages/domain/src/edges/routing/index.ts
packages/canvas-engine/src/index.ts

# Browser bootstrap: finds #root and calls createRoot, so it can only run against a real document
# root. Everything it composes (AppProviders, AppRoutes) is covered by unit tests; the file itself
# is exercised by the e2e and visual jobs, which load the built bundle.
apps/web/src/main.tsx

# Browser-only engine boundary: the whole effect needs a real 2D canvas context, pointer capture
# and ResizeObserver, so under jsdom it returns early by design (see the guard in the file). The
# behaviour it wires up is covered by the e2e and visual jobs instead.
apps/web/src/app/canvas/useCanvasEngine.ts
