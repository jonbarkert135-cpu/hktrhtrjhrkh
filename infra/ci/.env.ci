# CI-only defaults for ephemeral service containers. Dummy values, never secrets — real values
# always come from the job environment, which takes precedence (packages/config/src/env-file.ts).
NODE_ENV=test
NEXUS_ENV=local
LOG_LEVEL=warn

DATABASE_URL=postgres://nexus:test@localhost:5432/nexus_test
DATABASE_POOL_MAX=5
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexus-ci
S3_ACCESS_KEY_ID=ci-only-access-key
S3_SECRET_ACCESS_KEY=ci-only-secret-key
S3_FORCE_PATH_STYLE=true

AUTH_SECRET=ci-only-auth-secret-not-a-real-secret-32
AUTH_TRUSTED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

SYNC_URL=http://localhost:3002
SYNC_SHARED_SECRET=ci-only-sync-secret-not-a-real-secret-32
RUNNER_URL=http://localhost:3003
RUNNER_SHARED_SECRET=ci-only-runner-secret-not-a-real-sec-32
EGRESS_PROXY_URL=http://localhost:3128
EGRESS_ALLOWLIST=

AI_PROVIDER=mock
NEXUS_INTEGRATIONS_MODE=stub
